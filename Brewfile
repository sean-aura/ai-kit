# Tools installed by install.sh with `brew bundle` (macOS, or Homebrew on Linux).
# Ollama comes from the Homebrew formula (server + CLI), not the desktop app,
# so it only updates when you run `ai update`.
brew "ollama"
brew "jq"
brew "fzf"
brew "uv"        # installs Open WebUI and llm in isolated environments
brew "pandoc"    # ai docx: Markdown -> Word
brew "ocrmypdf"  # ai ocr: make scanned PDFs readable

# Optional: coding agent used by `ai code`. Uncomment and re-run install.sh.
